# Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
# The intent gate runs before every retrieval; a small model keeps it fast.
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Postgres (matches docker-compose service `db`)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=challenge
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline-pass

# App
RECIPES_TABLE_PREFIX=recipes
RECIPES_DIR=data/recipes
# false = answer every request with the closest match, no off-topic refusal and no gate call.
INTENT_GATE_ENABLED=true
RETRIEVER_TOP_K=3
RETRIEVER_CANDIDATES=8
MAX_IMAGE_BYTES=10485760
LOG_LEVEL=INFO
